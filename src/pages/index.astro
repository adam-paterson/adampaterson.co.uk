---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import CareerTimeline from '../components/CareerTimeline';
import AnimatedSection from '../components/AnimatedSection';
import TechStack from '../components/TechStack';

const capabilities = [
  {
    code: "01",
    title: "Agentic Workflow Design",
    summary: "Practical agent systems that can be inspected, measured, and connected to real operational processes.",
    details: ["Task decomposition", "Human-in-the-loop review", "Traceable execution"]
  },
  {
    code: "02",
    title: "Commerce Architecture",
    summary: "Scalable e-commerce platforms with clear integration boundaries and delivery paths.",
    details: ["Shopify, Adobe Commerce, BigCommerce", "Headless and composable builds", "Discovery to launch"]
  },
  {
    code: "03",
    title: "Engineering Enablement",
    summary: "Technical leadership that turns ambiguous business problems into maintainable systems.",
    details: ["Solution design", "Code review and mentoring", "Build and deployment hygiene"]
  }
];

const principles = [
  "Start with the workflow, not the model",
  "Make system behavior observable",
  "Prefer boring infrastructure until the problem proves otherwise",
  "Explain trade-offs in language teams can act on"
];

const pageTitle = "Adam Paterson - AI Systems and Commerce Engineer";
const pageDescription = "AI systems and commerce engineer helping teams design practical agent workflows, resilient platforms, and clear technical strategies.";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
>
  <main class="min-h-screen">
    <Hero client:load />

    <section id="services" class="border-t border-b py-24 hairline sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="mb-12 grid gap-8 lg:grid-cols-[0.7fr,1fr] lg:items-end">
          <div>
            <p class="section-kicker">Practice Areas</p>
            <h2 class="section-title">Practical AI and commerce architecture, without theatre.</h2>
          </div>
          <p class="section-copy">
            I help teams move from loose technical ambition to systems they can explain, operate, and improve. The work sits where product judgement, software architecture, and AI capability meet.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {capabilities.map((capability) => (
            <article class="technical-panel-strong flex min-h-[24rem] flex-col justify-between">
              <div>
                <div class="mb-10 flex items-center justify-between border-b pb-4 hairline">
                  <span class="mono-label">{capability.code}</span>
                  <span class="system-pill">Available</span>
                </div>
                <h3 class="mb-4 text-2xl font-semibold">{capability.title}</h3>
                <p class="leading-7" style="color: var(--color-muted);">{capability.summary}</p>
              </div>
              <ul class="mt-10 space-y-3">
                {capability.details.map((detail) => (
                  <li class="flex items-start gap-3 text-sm" style="color: var(--color-muted);">
                    <span class="mt-2 h-px w-7 shrink-0" style="background: var(--color-line-strong);"></span>
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </AnimatedSection>
    </section>

    <section id="approach" class="py-24 sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="grid gap-10 lg:grid-cols-[0.9fr,1.1fr] lg:items-start">
          <div>
            <p class="section-kicker">Operating Model</p>
            <h2 class="section-title">Systems thinking, kept close to delivery.</h2>
          </div>
          <div class="technical-panel">
            <div class="grid gap-4 sm:grid-cols-2">
              {principles.map((principle, index) => (
                <div class="border-l pl-4 hairline">
                  <div class="mono-label mb-3">P{String(index + 1).padStart(2, "0")}</div>
                  <p class="text-lg leading-7">{principle}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </AnimatedSection>
    </section>

    <TechStack client:load />

    <section id="about" class="border-y py-24 hairline sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="grid gap-12 lg:grid-cols-[1fr,0.8fr] lg:items-center">
          <div>
            <p class="section-kicker">Profile</p>
            <h2 class="section-title">Fifteen years turning ambiguous digital problems into working platforms.</h2>
            <p class="section-copy mt-6">
              My background is enterprise commerce, technical discovery, and full-stack delivery. The current focus is applying AI where it improves real workflows: research, operations, engineering support, and customer-facing systems that need strong guardrails.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="technical-panel">
              <div class="text-4xl font-semibold">15+</div>
              <div class="mono-label mt-3">Years Experience</div>
            </div>
            <div class="technical-panel">
              <div class="text-4xl font-semibold">100+</div>
              <div class="mono-label mt-3">Projects Delivered</div>
            </div>
            <div class="technical-panel">
              <div class="text-4xl font-semibold">6+</div>
              <div class="mono-label mt-3">Commerce Platforms</div>
            </div>
            <div class="technical-panel">
              <div class="text-4xl font-semibold">20+</div>
              <div class="mono-label mt-3">Industries Served</div>
            </div>
          </div>
        </div>
      </AnimatedSection>
    </section>

    <section id="career" class="py-24 sm:py-32">
      <div class="section-shell mb-12">
        <p class="section-kicker">Career Ledger</p>
        <h2 class="section-title">Selected delivery record.</h2>
      </div>
      <CareerTimeline client:load />
    </section>

    <section class="border-t py-24 hairline sm:py-32">
      <div class="section-shell">
        <div class="technical-panel-strong grid gap-8 lg:grid-cols-[1fr,auto] lg:items-center">
          <div>
            <p class="section-kicker">Contact</p>
            <h2 class="section-title">Need a clearer path through an AI or commerce system?</h2>
            <p class="section-copy mt-5">
              Send the problem, the constraints, and what is at stake. I will help turn it into a practical technical route.
            </p>
          </div>
          <a href="mailto:hello@adampaterson.co.uk" class="btn-primary">Get in Touch</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((element) => {
    const anchor = element as HTMLAnchorElement;
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      if (!href) return;
      document.querySelector(href)?.scrollIntoView({
        behavior: 'smooth'
      });
    });
  });
</script>
