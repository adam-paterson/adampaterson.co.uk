---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

let posts: CollectionEntry<'blog'>[] = [];
let error = null;

try {
  posts = await getCollection('blog');
} catch (e) {
  error = e;
  console.error('Full error:', e);
}

if (posts.length > 0) {
  posts.sort((a, b) => 
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
}
---

<Layout title="Blog | Adam Paterson">
	<main class="min-h-screen">
		<section class="border-b py-24 hairline sm:py-32">
			<div class="section-shell">
				<p class="section-kicker">Writing</p>
				<h1 class="max-w-4xl text-5xl font-semibold leading-tight sm:text-6xl">Notes on AI systems, commerce architecture, and engineering practice.</h1>
			</div>
		</section>

		<section class="py-24 sm:py-32">
			<div class="section-shell">
		{error && (
			<p class="technical-panel" style="color: var(--color-warning);">
				Error loading articles: {error instanceof Error ? error.message : 'Unknown error'}
			</p>
		)}
		{posts.length === 0 ? (
			<div class="technical-panel space-y-4">
				<p style="color: var(--color-muted);">No articles found.</p>
				<pre class="text-sm">
					{JSON.stringify({ posts, error }, null, 2)}
				</pre>
			</div>
		) : (
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<article class="technical-panel-strong overflow-hidden p-0">
						{post.data.image && (
							<img 
								src={post.data.image} 
								alt={post.data.title}
								class="h-48 w-full border-b object-cover hairline"
							/>
						)}
						<div class="p-6">
							<div class="mono-label mb-4">
								<time datetime={new Date(post.data.date).toISOString()}>
									{new Date(post.data.date).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric'
									})}
								</time>
							</div>
							<h2 class="mb-4 text-2xl font-semibold leading-tight">
								<a href={`/blog/${post.id}`} class="link-underline">
									{post.data.title}
								</a>
							</h2>
							{post.data.excerpt && (
								<p class="mb-6 leading-7" style="color: var(--color-muted);">
									{post.data.excerpt}
								</p>
							)}
							<a 
								href={`/blog/${post.id}`}
								class="btn-secondary"
							>
								Read Article
							</a>
						</div>
					</article>
				))}
			</div>
		)}
			</div>
		</section>
	</main>
</Layout>
