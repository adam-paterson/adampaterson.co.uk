---
import Layout from '../layouts/Layout.astro';
import AnimatedSection from '../components/AnimatedSection';

const pageTitle = "About Me - Adam Paterson";
const pageDescription = "Learn more about Adam Paterson, an AI systems and commerce engineer focused on practical delivery and clear technical thinking.";

const profileStats = [
  { value: "15+", label: "Years Experience" },
  { value: "100+", label: "Projects Delivered" },
  { value: "6+", label: "Commerce Platforms" },
  { value: "20+", label: "Industries Served" }
];

const interests = [
  {
    title: "AI Systems",
    description: "I am interested in how agents, retrieval, evaluation, and human review can make knowledge work more reliable."
  },
  {
    title: "Photography",
    description: "Photography keeps me attentive to framing, constraint, and the way small details change how something is understood."
  },
  {
    title: "Games",
    description: "Good games are systems with feedback, trade-offs, and visible rules. That way of thinking shows up in my engineering work."
  },
  {
    title: "Reading",
    description: "I read across technology, business, and speculative fiction to keep my thinking broad without losing practical judgement."
  }
];

const values = [
  {
    title: "Clarity",
    description: "Complexity is acceptable. Confusion is not. I prefer diagrams, plain language, and named assumptions."
  },
  {
    title: "Delivery",
    description: "Architecture needs a route to production, a way to be tested, and an owner after launch."
  },
  {
    title: "Judgement",
    description: "AI work needs restraint. The useful question is where the system should help, where it should stop, and how people verify it."
  }
];

const notes = [
  "Built my first website young enough that table layouts still felt normal",
  "I enjoy explaining technical trade-offs to non-technical teams",
  "I care about the boring work: naming, interfaces, logs, handovers, and supportability",
  "I prefer useful prototypes over speculative slideware"
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen">
    <section class="border-b py-24 hairline sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.8fr] lg:items-end">
          <div>
            <p class="section-kicker">About</p>
            <h1 class="max-w-4xl text-5xl font-semibold leading-tight sm:text-6xl">
              I help teams make complex technical systems easier to understand and safer to ship.
            </h1>
          </div>
          <p class="section-copy">
            I am an AI systems and commerce engineer with a background in enterprise e-commerce, technical discovery, and delivery leadership. My work is strongest where ambiguous business goals need a clear technical route.
          </p>
        </div>
      </AnimatedSection>
    </section>

    <section class="py-24 sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="section-kicker">Profile</p>
            <h2 class="section-title">Practical engineering, direct communication, and a bias toward working systems.</h2>
            <div class="mt-8 space-y-5 section-copy">
              <p>
                I have spent more than fifteen years building and supporting digital commerce systems across agencies, product teams, and enterprise clients.
              </p>
              <p>
                AI is now a major part of that work, but I treat it as part of a system rather than a magic layer: inputs, outputs, people, risks, review points, and operational reality all matter.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            {profileStats.map((stat) => (
              <div class="technical-panel">
                <div class="text-4xl font-semibold">{stat.value}</div>
                <div class="mono-label mt-3">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </AnimatedSection>
    </section>

    <section class="border-y py-24 hairline sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="mb-12 grid gap-8 lg:grid-cols-[0.7fr_1fr] lg:items-end">
          <div>
            <p class="section-kicker">Interests</p>
            <h2 class="section-title">What shapes the work.</h2>
          </div>
          <p class="section-copy">
            The useful thread is systems thinking: how things are framed, how feedback appears, and how people make decisions with imperfect information.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {interests.map((interest, index) => (
            <article class="technical-panel">
              <div class="mb-5 flex items-center justify-between border-b pb-4 hairline">
                <span class="mono-label">I{String(index + 1).padStart(2, "0")}</span>
                <span class="system-pill">{interest.title}</span>
              </div>
              <p class="leading-7" style="color: var(--color-muted);">{interest.description}</p>
            </article>
          ))}
        </div>
      </AnimatedSection>
    </section>

    <section class="py-24 sm:py-32">
      <AnimatedSection client:load className="section-shell">
        <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
          <div>
            <p class="section-kicker">Values</p>
            <div class="space-y-5">
              {values.map((value, index) => (
                <article class="technical-panel">
                  <div class="mono-label mb-3">V{String(index + 1).padStart(2, "0")}</div>
                  <h3 class="text-xl font-semibold">{value.title}</h3>
                  <p class="mt-3 leading-7" style="color: var(--color-muted);">{value.description}</p>
                </article>
              ))}
            </div>
          </div>

          <div>
            <p class="section-kicker">Notes</p>
            <div class="technical-panel-strong">
              <ul class="space-y-5">
                {notes.map((note) => (
                  <li class="flex gap-4 leading-7" style="color: var(--color-muted);">
                    <span class="mt-3 h-px w-8 shrink-0" style="background: var(--color-line-strong);"></span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </AnimatedSection>
    </section>
  </main>
</Layout>
